# Copy to .env and fill in. Letters and numbers only (the .bat scripts read
# this file). Don't ship this .example file to the client.

# GitHub account that owns the images (lowercase), and a read:packages token
GHCR_OWNER=sawyeyintaung
GHCR_USER=sawyeyintaung
GHCR_TOKEN=ghp_the_read_only_token

# Never change the password after the first install
POSTGRES_USER=hotel
POSTGRES_PASSWORD=SomeStrongPassword123
POSTGRES_DB=hotel

# Signs the login sessions. Make one with:  openssl rand -hex 32
# Changing it later logs everyone out, nothing else.
BETTER_AUTH_SECRET=

# What start.bat opens. Must also be in CORS_ORIGIN, or logins are refused.
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Image tag to run: latest, a version like 1.2.0, or sha-abc1234
APP_VERSION=latest
