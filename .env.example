# Copy to .env and fill in. Letters and numbers only (the .bat scripts read
# this file). Don't ship this .example file to the client.

# Docker Hub account that publishes the public images (no login needed to pull)
DOCKERHUB_USER=your-dockerhub-username

# Never change the password after the first install
POSTGRES_USER=hotel
POSTGRES_PASSWORD=SomeStrongPassword123
POSTGRES_DB=hotel

# Signs the login sessions. Make one with:  openssl rand -hex 32
# Changing it later logs everyone out, nothing else.
BETTER_AUTH_SECRET=

# The first admins, created on the first start (comma-separated, all with this
# password, 8-128 characters). Each admin changes it after logging in. Only
# used while there's no admin, so changing these later does nothing.
SEED_ADMIN_USERNAMES=owner
SEED_ADMIN_PASSWORD=

# What start.bat / start.command opens. Must also be in CORS_ORIGIN, or logins are refused.
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Image tag to run: latest, or a version like 1.2.0 to roll back.
# Set it back to latest afterwards, or update.bat stays on that version.
APP_VERSION=latest
